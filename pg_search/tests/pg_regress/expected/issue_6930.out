EXPLAIN (COSTS OFF)
SELECT a.id, a.x / n.i AS q FROM issue_6930_a a LEFT JOIN issue_6930_n n ON n.id = a.id
WHERE a.body @@@ 'ok' AND a.id IN (1, 2, 4) ORDER BY a.id LIMIT 20;
                                                                                                                                                            QUERY PLAN                                                                                                                                                            
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: a LEFT n
   Join Cond: n.id = a.id
   Limit: 20
   Order By: a.id asc
   DataFusion Physical Plan: 
     : SortExec: TopK(fetch=20), expr=[col_1@0 ASC NULLS LAST], preserve_partitioning=[false]
     :   ProjectionExec: expr=[id@1 as col_1, pdb_float_div(x@2, CAST(i@3 AS Float64)) as col_2, ctid_0@0 as ctid_0]
     :     VisibilityFilterExec: tables=[a]
     :       HashJoinExec: mode=CollectLeft, join_type=Right, on=[(id@0, id@1)], projection=[ctid_0@2, id@3, x@4, i@1]
     :         CooperativeExec
     :           PgSearchScan: table=n, segments=1, visibility=eager, query="all"
     :         CooperativeExec
     :           PgSearchScan: table=a, segments=1, dynamic_filters=1, query={"boolean":{"must":[{"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"ok","lenient":null,"conjunction_mode":null}}}},{"term_set":{"terms":[{"field":"id","value":1},{"field":"id","value":2},{"field":"id","value":4}]}}]}}
(14 rows)

SELECT a.id, a.x / n.i AS q FROM issue_6930_a a LEFT JOIN issue_6930_n n ON n.id = a.id
WHERE a.body @@@ 'ok' AND a.id IN (1, 2, 4) ORDER BY a.id LIMIT 20;
