-- Errors: -0, 0 / 0 and Infinity / 0, then overflow and underflow in float8
-- and float4, all raised by pdb_float_div.
EXPLAIN (COSTS OFF)
SELECT a.x / b.d, a.y / b.e FROM issue_6930_a a JOIN issue_6930_b b ON b.id = a.id
WHERE a.body @@@ 'big' LIMIT 20;
                                                                                     QUERY PLAN                                                                                      
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: a INNER b
   Join Cond: b.id = a.id
   Limit: 20
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[pdb_float_div(x@1, d@5) as col_1, pdb_float_div(CAST(y@2 AS Float32), CAST(e@6 AS Float32)) as col_2]
     :   GlobalLimitExec: skip=0, fetch=20
     :     VisibilityFilterExec: tables=[a, b]
     :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, id@0)]
     :         CooperativeExec
     :           PgSearchScan: table=a, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"big","lenient":null,"conjunction_mode":null}}}}
     :         CooperativeExec
     :           PgSearchScan: table=b, segments=1, dynamic_filters=1, query="all"
(13 rows)

