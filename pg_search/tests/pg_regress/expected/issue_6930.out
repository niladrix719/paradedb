-- Domains over float4 keep their exact value too
CREATE DOMAIN issue_6930_real AS real;
CREATE TABLE issue_6930_dm (id int PRIMARY KEY, body text, v issue_6930_real);
INSERT INTO issue_6930_dm VALUES (13, 'ok', 0.1);
CREATE INDEX issue_6930_dm_idx ON issue_6930_dm USING paradedb (id, body, v);
EXPLAIN (COSTS OFF)
SELECT dm.id, dm.v / b.d AS q, dm.v = 0.1::real AS eq4
FROM issue_6930_dm dm JOIN issue_6930_b b ON b.id = dm.id
WHERE dm.body @@@ 'ok' LIMIT 20;
                                                                                      QUERY PLAN                                                                                       
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: dm INNER b
   Join Cond: b.id = dm.id
   Limit: 20
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@2 as col_1, pdb_float_div(CAST(__common_expr_1@0 AS Float64), d@3) as col_2, __common_expr_1@0 = 0.1 as col_3, ctid_0@1 as ctid_0]
     :   ProjectionExec: expr=[CAST(v@2 AS Float32) as __common_expr_1, ctid_0@0 as ctid_0, id@1 as id, d@4 as d]
     :     GlobalLimitExec: skip=0, fetch=20
     :       VisibilityFilterExec: tables=[dm, b]
     :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, id@0)]
     :           CooperativeExec
     :             PgSearchScan: table=dm, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"ok","lenient":null,"conjunction_mode":null}}}}
     :           CooperativeExec
     :             PgSearchScan: table=b, segments=1, dynamic_filters=1, query="all"
(14 rows)

SELECT dm.id, dm.v / b.d AS q, dm.v = 0.1::real AS eq4
FROM issue_6930_dm dm JOIN issue_6930_b b ON b.id = dm.id
WHERE dm.body @@@ 'ok' LIMIT 20;
