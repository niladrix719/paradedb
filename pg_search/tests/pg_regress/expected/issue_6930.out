CREATE EXTENSION IF NOT EXISTS pg_search;
CREATE TABLE issue_6930_i (id int PRIMARY KEY, body text, f float8, r float4);
CREATE TABLE issue_6930_e (id int PRIMARY KEY, tag text, b int4, z float4);
INSERT INTO issue_6930_i VALUES (1, 'alpha', 0.0, 0.0), (2, 'beta', 1.0, 3.0);
INSERT INTO issue_6930_e VALUES (1, 'x', 1, 1.0), (2, 'y', 0, 0.0);
CREATE INDEX issue_6930_i_idx ON issue_6930_i USING paradedb (id, body, f, r);
CREATE INDEX issue_6930_e_idx ON issue_6930_e USING paradedb (id, tag, b, z);
SET paradedb.enable_join_custom_scan = on;
-- Float division in a Join Scan is evaluated natively
EXPLAIN (COSTS OFF)
SELECT i.id FROM issue_6930_i i JOIN issue_6930_e e ON e.id = i.id
WHERE i.body @@@ 'beta' AND (i.f / e.b) > 0 LIMIT 10;
                                                                                      QUERY PLAN                                                                                      
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: i INNER e
   Join Cond: e.id = i.id
   Join Predicate: heap:((i.f / (e.b)::double precision) > '0'::double precision)
   Limit: 10
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@1 as col_1, ctid_0@0 as ctid_0, ctid_1@3 as ctid_1]
     :   GlobalLimitExec: skip=0, fetch=10
     :     VisibilityFilterExec: tables=[i, e]
     :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, id@1)], filter=pdb_float_div(f@0, CAST(b@1 AS Float64)) > 0
     :         CooperativeExec
     :           PgSearchScan: table=i, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"beta","lenient":null,"conjunction_mode":null}}}}
     :         CooperativeExec
     :           PgSearchScan: table=e, segments=1, dynamic_filters=1, query="all"
(14 rows)

-- Division by zero raises an error instead of yielding Infinity
SELECT i.id FROM issue_6930_i i JOIN issue_6930_e e ON e.id = i.id
WHERE i.body @@@ 'beta' AND (i.f / e.b) > 0 LIMIT 10;
ERROR:  division by zero
SELECT i.id, (i.f / e.b) AS q FROM issue_6930_i i JOIN issue_6930_e e ON e.id = i.id
WHERE i.body @@@ 'beta' LIMIT 10;
ERROR:  division by zero
SELECT i.id, (i.r / e.z) AS q FROM issue_6930_i i JOIN issue_6930_e e ON e.id = i.id
WHERE i.body @@@ 'beta' LIMIT 10;
ERROR:  division by zero
SELECT i.id, (e.z / i.r) AS q FROM issue_6930_i i JOIN issue_6930_e e ON e.id = i.id
WHERE i.body @@@ 'alpha' LIMIT 10;
ERROR:  division by zero
-- Division by a non-zero value is unchanged
SELECT i.id, (i.f / e.b) AS q, (i.r / e.z) AS p FROM issue_6930_i i JOIN issue_6930_e e ON e.id = i.id
WHERE i.body @@@ 'alpha' AND (i.f / e.b) >= 0 LIMIT 10;
 id | q | p 
----+---+---
  1 | 0 | 0
(1 row)

-- Float division runs natively with PostgreSQL's checks (#7135): x and d are
-- float8, y and e are float4.
CREATE TABLE issue_6930_a (id int PRIMARY KEY, body text, x float8, y float4);
CREATE TABLE issue_6930_b (id int PRIMARY KEY, tag text, d float8, e float4);
INSERT INTO issue_6930_a VALUES
    (1, 'ok', 6, 6), (2, 'ok', '-0', '-0'), (3, 'ok', 1, 1), (4, 'ok', -1, -1),
    (5, 'ok', 'Infinity', 'Infinity'), (6, 'ok', '-Infinity', '-Infinity'),
    (7, 'ok', 'Infinity', 'Infinity'), (8, 'ok', 'NaN', 'NaN'), (9, 'ok', 1, 1),
    (10, 'ok', NULL, NULL), (11, 'ok', 1, 1), (12, 'ok', 3e38, 3e38), (13, 'ok', 0.1, 0.1),
    (20, 'negzero', 1, 1), (21, 'zerozero', 0, 0), (22, 'infzero', 'Infinity', 'Infinity'),
    (23, 'big', 1e308, 3e38), (24, 'tiny', 1e-308, 1e-38);
INSERT INTO issue_6930_b VALUES
    (1, 'x', 3, 3), (2, 'x', 5, 5), (3, 'x', 'Infinity', 'Infinity'),
    (4, 'x', 'Infinity', 'Infinity'), (5, 'x', 2, 2), (6, 'x', 2, 2),
    (7, 'x', 'Infinity', 'Infinity'), (8, 'x', 0, 0), (9, 'x', 'NaN', 'NaN'),
    (10, 'x', 0, 0), (11, 'x', NULL, NULL), (12, 'x', 0.5, 0.5), (13, 'x', 0.1, 0.1),
    (20, 'x', '-0', '-0'), (21, 'x', 0, 0), (22, 'x', 0, 0),
    (23, 'x', 0.5, 0.5), (24, 'x', 1e300, 1e30);
CREATE INDEX issue_6930_a_idx ON issue_6930_a USING paradedb (id, body, x, y);
CREATE INDEX issue_6930_b_idx ON issue_6930_b USING paradedb (id, tag, d, e);
-- No PostgreSQL expression UDF in the plan: float8 / float8, float4 / float4
-- (evaluated in float4) and float4 / float8 all use pdb_float_div.
EXPLAIN (COSTS OFF)
SELECT a.id, a.x / b.d, a.y / b.e, a.y / b.d FROM issue_6930_a a JOIN issue_6930_b b ON b.id = a.id
WHERE a.body @@@ 'ok' AND (a.x / b.e) > 0 LIMIT 20;
                                                                                                                                     QUERY PLAN                                                                                                                                     
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: a INNER b
   Join Cond: b.id = a.id
   Join Predicate: heap:((a.x / b.e) > '0'::double precision)
   Limit: 20
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@3 as col_1, pdb_float_div(x@4, __common_expr_1@0) as col_2, pdb_float_div(__common_expr_2@1, CAST(e@6 AS Float32)) as col_3, pdb_float_div(CAST(__common_expr_2@1 AS Float64), __common_expr_1@0) as col_4, ctid_0@2 as ctid_0, ctid_1@5 as ctid_1]
     :   ProjectionExec: expr=[d@7 as __common_expr_1, CAST(y@3 AS Float32) as __common_expr_2, ctid_0@0 as ctid_0, id@1 as id, x@2 as x, ctid_1@4 as ctid_1, e@6 as e]
     :     GlobalLimitExec: skip=0, fetch=20
     :       VisibilityFilterExec: tables=[a, b]
     :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, id@1)], filter=pdb_float_div(x@0, CAST(CAST(e@1 AS Float32) AS Float64)) > 0
     :           CooperativeExec
     :             PgSearchScan: table=a, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"ok","lenient":null,"conjunction_mode":null}}}}
     :           CooperativeExec
     :             PgSearchScan: table=b, segments=1, dynamic_filters=1, query="all"
(15 rows)

-- Signed zero, infinities, NaN and NULL follow PostgreSQL, and float4 is
-- widened exactly in mixed divisions (id 13). 3e38 / 0.5 overflows float4 but
-- not float8, so only the float4 / float8 mixes succeed for id 12.
SELECT a.id, a.x / b.d AS f8, a.y / b.e AS f4, a.y / b.d AS f48, a.x / b.e AS f84
FROM issue_6930_a a JOIN issue_6930_b b ON b.id = a.id
WHERE a.body @@@ 'ok' AND a.id <> 12 ORDER BY a.id LIMIT 20;
 id |    f8     |    f4     |        f48         |        f84        
----+-----------+-----------+--------------------+-------------------
  1 |         2 |         2 |                  2 |                 2
  2 |        -0 |        -0 |                 -0 |                -0
  3 |         0 |         0 |                  0 |                 0
  4 |        -0 |        -0 |                 -0 |                -0
  5 |  Infinity |  Infinity |           Infinity |          Infinity
  6 | -Infinity | -Infinity |          -Infinity |         -Infinity
  7 |       NaN |       NaN |                NaN |               NaN
  8 |       NaN |       NaN |                NaN |               NaN
  9 |       NaN |       NaN |                NaN |               NaN
 10 |           |           |                    |                  
 11 |           |           |                    |                  
 13 |         1 |         1 | 1.0000000149011612 | 0.999999985098839
(12 rows)

SELECT a.id, a.y / b.d AS f48, a.x / b.e AS f84
FROM issue_6930_a a JOIN issue_6930_b b ON b.id = a.id
WHERE a.body @@@ 'ok' AND a.id = 12 LIMIT 20;
 id |          f48           |  f84  
----+------------------------+-------
 12 | 6.0000000109955115e+38 | 6e+38
(1 row)

-- float4 columns keep their exact value in other mixed float4 / float8 expressions
SELECT a.id, a.y + b.d AS plus, a.y * b.d AS mul, a.y = b.d AS eq48,
       (a.y = 0.1::float4 OR b.d > 100) AS eq4, (a.y > 0.1::float8 OR b.d > 100) AS gt48
FROM issue_6930_a a JOIN issue_6930_b b ON b.id = a.id
WHERE a.body @@@ 'ok' AND a.id IN (12, 13) ORDER BY a.id LIMIT 20;
 id |          plus          |          mul           | eq48 | eq4 | gt48 
----+------------------------+------------------------+------+-----+------
 12 | 3.0000000054977558e+38 | 1.5000000027488779e+38 | f    | f   | t
 13 |    0.20000000149011612 |   0.010000000149011612 | f    | t   | t
(2 rows)

-- Filters with OR and IS NULL
EXPLAIN (COSTS OFF)
SELECT a.id FROM issue_6930_a a JOIN issue_6930_b b ON b.id = a.id
WHERE a.body @@@ 'ok' AND a.id <> 12 AND ((a.x / b.d) > 1 OR (a.x / b.d) IS NULL)
ORDER BY a.id LIMIT 20;
                                                                                                                                                          QUERY PLAN                                                                                                                                                           
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: a INNER b
   Join Cond: b.id = a.id
   Join Predicate: heap:(((a.x / b.d) > '1'::double precision) OR ((a.x / b.d) IS NULL))
   Limit: 20
   Order By: b.id asc
   DataFusion Physical Plan: 
     : SortExec: TopK(fetch=20), expr=[col_1@0 ASC NULLS LAST], preserve_partitioning=[false]
     :   ProjectionExec: expr=[id@0 as col_1, ctid_0@1 as ctid_0, ctid_1@2 as ctid_1]
     :     VisibilityFilterExec: tables=[a, b]
     :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, id@1)], filter=pdb_float_div(x@0, d@1) > 1 OR pdb_float_div(x@0, d@1) IS NULL, projection=[ctid_0@0, id@1, ctid_1@3, id@4]
     :         CooperativeExec
     :           PgSearchScan: table=a, segments=1, dynamic_filters=1, query={"boolean":{"must":[{"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"ok","lenient":null,"conjunction_mode":null}}}},{"boolean":{"must":[{"exists":{"field":"id"}}],"must_not":[{"term":{"field":"id","value":12}}]}}]}}
     :         CooperativeExec
     :           PgSearchScan: table=b, segments=1, dynamic_filters=1, query="all"
(15 rows)

SELECT a.id FROM issue_6930_a a JOIN issue_6930_b b ON b.id = a.id
WHERE a.body @@@ 'ok' AND a.id <> 12 AND ((a.x / b.d) > 1 OR (a.x / b.d) IS NULL)
ORDER BY a.id LIMIT 20;
 id 
----
  1
  5
  7
  8
  9
 10
 11
(7 rows)

-- -0 equals 0, as in PostgreSQL
SELECT a.id, a.x / b.d AS q FROM issue_6930_a a JOIN issue_6930_b b ON b.id = a.id
WHERE a.body @@@ 'ok' AND (a.x / b.d) = 0 ORDER BY a.id LIMIT 20;
 id | q  
----+----
  2 | -0
  3 |  0
  4 | -0
(3 rows)

-- Integer operands are cast to float natively, rounding like PostgreSQL
-- (2^53 + 1 and 2^24 + 1 are not representable).
CREATE TABLE issue_6930_n (id int PRIMARY KEY, body text, s int2, i int4, l int8);
INSERT INTO issue_6930_n VALUES
    (1, 'ok', 7, 7, 7), (2, 'ok', -3, 16777217, 9007199254740993), (3, 'ok', 0, 0, 0);
CREATE INDEX issue_6930_n_idx ON issue_6930_n USING paradedb (id, body, s, i, l);
EXPLAIN (COSTS OFF)
SELECT a.x / n.i, a.y / n.s, n.l::float4 FROM issue_6930_a a JOIN issue_6930_n n ON n.id = a.id
WHERE a.body @@@ 'ok' AND (a.x / n.l) >= 0 LIMIT 20;
                                                                                                                 QUERY PLAN                                                                                                                 
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: a INNER n
   Join Cond: n.id = a.id
   Join Predicate: heap:((a.x / (n.l)::double precision) >= '0'::double precision)
   Limit: 20
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[pdb_float_div(x@2, CAST(i@7 AS Float64)) as col_1, pdb_float_div(CAST(CAST(y@3 AS Float32) AS Float64), CAST(s@8 AS Float64)) as col_2, CAST(l@6 AS Float32) as col_3, ctid_0@0 as ctid_0, ctid_1@4 as ctid_1]
     :   GlobalLimitExec: skip=0, fetch=20
     :     VisibilityFilterExec: tables=[a, n]
     :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, id@1)], filter=pdb_float_div(x@0, CAST(l@1 AS Float64)) >= 0, projection=[ctid_0@5, id@6, x@7, y@8, ctid_1@0, id@1, l@2, i@3, s@4]
     :         CooperativeExec
     :           PgSearchScan: table=n, segments=1, query="all"
     :         CooperativeExec
     :           PgSearchScan: table=a, segments=1, dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"ok","lenient":null,"conjunction_mode":null}}}}
(14 rows)

SELECT a.id, a.x / n.s AS f8s, a.x / n.i AS f8i, a.x / n.l AS f8l, a.y / n.i AS f4i,
       n.l::float8 AS l8, n.l::float4 AS l4, n.i::real AS i4, a.x > n.i AS gt
FROM issue_6930_a a JOIN issue_6930_n n ON n.id = a.id
WHERE a.body @@@ 'ok' AND a.id IN (1, 2) ORDER BY a.id LIMIT 20;
 id |        f8s         |        f8i         |        f8l         |        f4i         |          l8           |      l4      |      i4       | gt 
----+--------------------+--------------------+--------------------+--------------------+-----------------------+--------------+---------------+----
  1 | 0.8571428571428571 | 0.8571428571428571 | 0.8571428571428571 | 0.8571428571428571 |                     7 |            7 |             7 | f
  2 |                  0 |                 -0 |                 -0 |                 -0 | 9.007199254740992e+15 | 9.007199e+15 | 1.6777216e+07 | f
(2 rows)

SELECT a.x / n.i FROM issue_6930_a a JOIN issue_6930_n n ON n.id = a.id
WHERE a.body @@@ 'ok' AND a.id = 3 LIMIT 20;
ERROR:  division by zero
