-- Aggregates over expressions of columnar fields, such as SUM(price - discount),
-- run on the DataFusion backend: Tantivy only aggregates single fields.
-- https://github.com/paradedb/paradedb/issues/7075
CREATE EXTENSION IF NOT EXISTS pg_search;
SET max_parallel_workers_per_gather = 0;
SET paradedb.enable_aggregate_custom_scan TO on;
CREATE TABLE expr_invoices (
    id SERIAL PRIMARY KEY,
    customer_id INTEGER,
    description TEXT,
    status TEXT,
    price FLOAT8,
    discount FLOAT8,
    qty INTEGER,
    amount NUMERIC(10, 2),
    fee NUMERIC(8, 3)
);
INSERT INTO expr_invoices (customer_id, description, status, price, discount, qty, amount, fee) VALUES
    (1, 'red widget', 'paid', 100.0, 10.0, 2, 10.50, 0.125),
    (1, 'blue widget', 'returned', 50.0, 5.0, 1, 20.00, 1.000),
    (2, 'green widget', 'paid', 75.0, NULL, 3, NULL, 0.500),
    (2, 'red gadget', 'returned', 20.0, 2.5, 4, 4.25, NULL),
    (3, 'blue gadget', 'pending', 60.0, 0.0, NULL, 99.99, 2.250);
CREATE INDEX expr_invoices_idx ON expr_invoices
USING paradedb (id, customer_id, description, (status::pdb.literal), price, discount, qty, amount, fee);
CREATE TABLE expr_customers (
    id INTEGER PRIMARY KEY,
    region TEXT
);
INSERT INTO expr_customers (id, region) VALUES (1, 'east'), (2, 'west'), (3, 'east');
CREATE INDEX expr_customers_idx ON expr_customers
USING paradedb (id, (region::pdb.literal));
-- The query from the issue, with and without a FILTER.
EXPLAIN (COSTS OFF, VERBOSE)
SELECT SUM(price - discount) FILTER (WHERE status = 'returned'),
       SUM(price - discount)
FROM expr_invoices
WHERE description ||| 'widget gadget';
                                                                                                                                 QUERY PLAN                                                                                                                                  
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Output: (sum((price - discount)) FILTER (WHERE (status = 'returned'::text))), (sum((price - discount)))
   Backend: DataFusion
   Indexes: expr_invoices_idx (expr_invoices)
   Aggregates: SUM((expr_invoices.price - expr_invoices.discount)), SUM((expr_invoices.price - expr_invoices.discount))
   DataFusion Physical Plan: 
     : AggregateExec: mode=Single, gby=[], aggr=[sum(__common_expr_1) FILTER (WHERE expr_invoices_0.status = Utf8View("returned")) as agg_0, sum(__common_expr_1) as agg_1]
     :   ProjectionExec: expr=[price@0 - discount@1 as __common_expr_1, status@2 as status]
     :     CooperativeExec
     :       PgSearchScan: table=expr_invoices, segments=1, visibility=eager, query={"with_index":{"query":{"match":{"field":"description","value":"widget gadget","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(10 rows)

SELECT SUM(price - discount) FILTER (WHERE status = 'returned'),
       SUM(price - discount)
FROM expr_invoices
WHERE description ||| 'widget gadget';
 sum  |  sum  
------+-------
 62.5 | 212.5
(1 row)

-- Operators, aggregates, and NULL propagation, grouped.
SELECT status,
       AVG(price * qty),
       MIN(price / 2),
       MAX(qty % 3),
       COUNT(price - discount),
       SUM(COALESCE(discount, 0) + 1),
       SUM(qty * 2),
       SUM(-qty)
FROM expr_invoices
WHERE description ||| 'widget gadget'
GROUP BY status
ORDER BY status;
  status  |  avg  | min  | max | count | sum | sum | sum 
----------+-------+------+-----+-------+-----+-----+-----
 paid     | 212.5 | 37.5 |   2 |     1 |  12 |  10 |  -5
 pending  |       |   30 |     |     1 |   1 |     |    
 returned |    65 |   10 |   1 |     2 | 9.5 |  10 |  -5
(3 rows)

-- HAVING over an expression aggregate.
SELECT status, SUM(price - discount)
FROM expr_invoices
WHERE description ||| 'widget gadget'
GROUP BY status
HAVING SUM(price - discount) > 60
ORDER BY status;
  status  | sum  
----------+------
 paid     |   90
 returned | 62.5
(2 rows)

-- An expression aggregate that only HAVING uses still runs on DataFusion.
EXPLAIN (COSTS OFF)
SELECT status
FROM expr_invoices
WHERE description ||| 'widget gadget'
GROUP BY status
HAVING SUM(price - discount) > 60;
                                                                                                                                         QUERY PLAN                                                                                                                                          
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Backend: DataFusion
   Indexes: expr_invoices_idx (expr_invoices)
   Group By: status
   Aggregates: SUM((expr_invoices.price - expr_invoices.discount))
   DataFusion Physical Plan: 
     : FilterExec: agg_0@1 > 60
     :   AggregateExec: mode=Single, gby=[status@0 as status], aggr=[sum(expr_invoices_0.price - expr_invoices_0.discount) as agg_0]
     :     CooperativeExec
     :       PgSearchScan: table=expr_invoices, segments=1, eager=[status], visibility=eager, query={"with_index":{"query":{"match":{"field":"description","value":"widget gadget","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(10 rows)

SELECT status
FROM expr_invoices
WHERE description ||| 'widget gadget'
GROUP BY status
HAVING SUM(price - discount) > 60
ORDER BY status;
  status  
----------
 paid
 returned
(2 rows)

-- An expression over columns of a joined table.
EXPLAIN (COSTS OFF)
SELECT c.region, SUM(i.price - i.discount)
FROM expr_invoices i JOIN expr_customers c ON i.customer_id = c.id
WHERE i.description ||| 'widget gadget'
GROUP BY c.region;
                                                                                                                                     QUERY PLAN                                                                                                                                     
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Backend: DataFusion
   Indexes: expr_invoices_idx (i), expr_customers_idx (c)
   Group By: region
   Aggregates: SUM((i.price - i.discount))
   DataFusion Physical Plan: 
     : AggregateExec: mode=Single, gby=[region@2 as region], aggr=[sum(i_0.price - i_0.discount) as agg_0]
     :   HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, customer_id@2)], projection=[price@2, discount@3, region@0]
     :     CooperativeExec
     :       PgSearchScan: table=c, segments=1, eager=[region], visibility=eager, query="all"
     :     CooperativeExec
     :       PgSearchScan: table=i, segments=1, dynamic_filters=1, visibility=eager, query={"with_index":{"query":{"match":{"field":"description","value":"widget gadget","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(12 rows)

SELECT c.region, SUM(i.price - i.discount), SUM(i.qty * c.id)
FROM expr_invoices i JOIN expr_customers c ON i.customer_id = c.id
WHERE i.description ||| 'widget gadget'
GROUP BY c.region
ORDER BY c.region;
 region | sum  | sum 
--------+------+-----
 east   |  195 |   3
 west   | 17.5 |  14
(2 rows)

-- DISTINCT counts the values of the expression, not of its columns: qty - customer_id
-- is 1, 0, 1, 2 where the (qty, customer_id) pairs are all different.
SELECT status, COUNT(DISTINCT qty - customer_id), SUM(DISTINCT qty * 2)
FROM expr_invoices
WHERE description ||| 'widget gadget'
GROUP BY status
ORDER BY status;
  status  | count | sum 
----------+-------+-----
 paid     |     1 |  10
 pending  |     0 |    
 returned |     2 |  10
(3 rows)

-- ORDER BY inside the aggregate, on a column.
SELECT status, array_agg(qty + 1 ORDER BY id)
FROM expr_invoices
WHERE description ||| 'widget gadget'
GROUP BY status
ORDER BY status;
  status  | array_agg 
----------+-----------
 paid     | {3,4}
 pending  | {NULL}
 returned | {2,5}
(3 rows)

