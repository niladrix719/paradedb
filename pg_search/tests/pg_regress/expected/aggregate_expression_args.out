-- Expressions other than float8 arithmetic are evaluated by PostgreSQL, so they
-- raise its errors and keep its types.
CREATE TABLE expr_edge (
    id SERIAL PRIMARY KEY,
    big_a BIGINT,
    big_b BIGINT,
    price FLOAT8,
    discount FLOAT8,
    shipped DATE,
    ordered DATE
);
INSERT INTO expr_edge (big_a, big_b, price, discount, shipped, ordered) VALUES
    (9223372036854775807, 2, 10.0, 0.0, '2024-01-05', '2024-01-01'),
    (1, 1, 20.0, 4.0, '2024-01-03', '2024-01-02');
CREATE INDEX expr_edge_idx ON expr_edge
USING paradedb (id, big_a, big_b, price, discount, shipped, ordered);
SELECT SUM(big_a * big_b) FROM expr_edge WHERE id @@@ pdb.all();
ERROR:  bigint out of range
SELECT SUM(price / discount) FROM expr_edge WHERE id @@@ pdb.all();
ERROR:  division by zero
-- float8 arithmetic runs natively, so an overflow gives Infinity where PostgreSQL errors.
-- Unary minus is evaluated by PostgreSQL.
EXPLAIN (COSTS OFF)
SELECT SUM(-price), MAX(price * 1e308) FROM expr_edge WHERE id @@@ pdb.all();
                                                                                                                                                                                                                                QUERY PLAN                                                                                                                                                                                                                                
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Backend: DataFusion
   Indexes: expr_edge_idx (expr_edge)
   Aggregates: SUM((- expr_edge.price)), MAX((expr_edge.price * '1e+308'::double precision))
   DataFusion Physical Plan: 
     : AggregateExec: mode=Single, gby=[], aggr=[sum(pdb_eval_expr_opexpr_878c2142(expr_edge_0.price)) as agg_0, max(expr_edge_0.price * ) as agg_1]
     :   CooperativeExec
     :     PgSearchScan: table=expr_edge, segments=1, visibility=eager, query={"with_index":{"query":{"all":{"field":"id"}}}}
(8 rows)

SELECT SUM(-price), MAX(price * 1e308) FROM expr_edge WHERE id @@@ pdb.all();
 sum |   max    
-----+----------
 -30 | Infinity
(1 row)

EXPLAIN (COSTS OFF)
SELECT MAX(shipped - ordered) FROM expr_edge WHERE id @@@ pdb.all();
                                                               QUERY PLAN                                                               
----------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Backend: DataFusion
   Indexes: expr_edge_idx (expr_edge)
   Aggregates: MAX((expr_edge.shipped - expr_edge.ordered))
   DataFusion Physical Plan: 
     : AggregateExec: mode=Single, gby=[], aggr=[max(pdb_eval_expr_opexpr_1a180e6a(expr_edge_0.shipped, expr_edge_0.ordered)) as agg_0]
     :   CooperativeExec
     :     PgSearchScan: table=expr_edge, segments=1, visibility=eager, query={"with_index":{"query":{"all":{"field":"id"}}}}
(8 rows)

