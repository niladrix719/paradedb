SET paradedb.enable_aggregate_custom_scan TO on;
-- A bare column still runs on Tantivy.
EXPLAIN (COSTS OFF)
SELECT SUM(price)
FROM expr_invoices
WHERE description ||| 'widget gadget';
                                                                                                QUERY PLAN                                                                                                 
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan) on expr_invoices
   Index: expr_invoices_idx
   Tantivy Query: {"with_index":{"query":{"match":{"field":"description","value":"widget gadget","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     Applies to Aggregates: SUM(price)
     Aggregate Definition: {"0":{"sum":{"field":"price","missing":null,"none_if_no_match":true}}}
(5 rows)

