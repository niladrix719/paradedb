SET paradedb.enable_aggregate_custom_scan TO on;
DROP TABLE expr_edge;
-- MPP: the expression is evaluated in each producer worker.
SET max_parallel_workers_per_gather TO 3;
SET max_parallel_workers TO 8;
SET min_parallel_table_scan_size TO 0;
SET parallel_setup_cost TO 0;
SET parallel_tuple_cost TO 0;
SET paradedb.global_mutable_segment_rows = 0;
CREATE TABLE expr_lines (
    id SERIAL PRIMARY KEY,
    note TEXT,
    bucket INTEGER,
    price FLOAT8,
    discount FLOAT8
);
CREATE INDEX expr_lines_idx ON expr_lines
USING paradedb (id, note, bucket, price, discount);
INSERT INTO expr_lines (note, bucket, price, discount)
SELECT 'line ' || g, g % 4, g * 1.5, g % 7
FROM generate_series(1, 500) AS g;
INSERT INTO expr_lines (note, bucket, price, discount)
SELECT 'line ' || g, g % 4, g * 1.5, g % 7
FROM generate_series(501, 1000) AS g;
EXPLAIN (COSTS OFF)
SELECT bucket, SUM(price - discount)
FROM expr_lines
WHERE note ||| 'line'
GROUP BY bucket;
                                                                                                                             QUERY PLAN                                                                                                                             
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Backend: DataFusion
   Indexes: expr_lines_idx (expr_lines)
   Group By: bucket
   Aggregates: SUM((expr_lines.price - expr_lines.discount))
   DataFusion Physical Plan: 
     : ┌───── DistributedExec
     : │ CoalescePartitionsExec
     : │   [Stage 2] => NetworkCoalesceExec: output_partitions=6, input_tasks=2
     : └──────────────────────────────────────────────────
     :   ┌───── Stage 2 ── tasks=2, partitions=3
     :   │ AggregateExec: mode=FinalPartitioned, gby=[bucket@0 as bucket], aggr=[sum(expr_lines_0.price - expr_lines_0.discount) as agg_0]
     :   │   [Stage 1] => NetworkShuffleExec: output_partitions=3, input_tasks=2
     :   └──────────────────────────────────────────────────
     :     ┌───── Stage 1 ── tasks=2, partitions=6
     :     │ RepartitionExec: partitioning=Hash([bucket@0], 6), input_partitions=1
     :     │   AggregateExec: mode=Partial, gby=[bucket@0 as bucket], aggr=[sum(expr_lines_0.price - expr_lines_0.discount) as agg_0]
     :     │     DistributedLeafExec:
     :     │       t0: PgSearchScan: table=expr_lines, segments=2, visibility=eager, query={"with_index":{"query":{"match":{"field":"note","value":"line","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :     │       t1: PgSearchScan: table=expr_lines, segments=2, visibility=eager, query={"with_index":{"query":{"match":{"field":"note","value":"line","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :     └──────────────────────────────────────────────────
(21 rows)

SELECT bucket, SUM(price - discount)
FROM expr_lines
WHERE note ||| 'line'
GROUP BY bucket
ORDER BY bucket;
 bucket |  sum   
--------+--------
      0 | 187497
      1 | 186373
      2 | 186750
      3 | 187127
(4 rows)

SET paradedb.enable_aggregate_custom_scan TO off;
SELECT bucket, SUM(price - discount)
FROM expr_lines
WHERE note ||| 'line'
GROUP BY bucket
ORDER BY bucket;
 bucket |  sum   
--------+--------
      0 | 187497
      1 | 186373
      2 | 186750
      3 | 187127
(4 rows)

DROP TABLE expr_lines;
DROP TABLE expr_customers;
DROP TABLE expr_invoices;
RESET paradedb.global_mutable_segment_rows;
RESET parallel_tuple_cost;
RESET parallel_setup_cost;
RESET min_parallel_table_scan_size;
RESET max_parallel_workers;
RESET max_parallel_workers_per_gather;
RESET paradedb.enable_aggregate_custom_scan;
